#!/bin/sh
#
# GIF ME
# as in: "GIF ME AN ANIMATED GIF, DAMMIT"
#
# Use imagemagick to make an animated gif of awesome. Upload to photos.natwelch.com.
#
# Examples:
#
#   gifme ~/Desktop/rtomayko.png ~/Desktop/pimpcane.jpg
#   gifme ~/IncriminatingPhotosOfKyle/*.jpg

set -e

output="$HOME/Desktop/animated.gif"

# Set delay to be 20 unless we set $DELAY
delay=${DELAY-20}

magick -delay "$delay" -loop 0 "$@" -resize 500 -layers OptimizeTransparency "$output"

photo "$output"
