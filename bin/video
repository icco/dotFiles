#!/usr/bin/env bash
#
# Upload videos to videos.natwelch.com and print their watch URLs. Each URL
# works once the background WebM conversion finishes.
#
# Examples:
#
#   video ~/Desktop/demo.mov
#   video ~/Movies/*.mp4

set -euo pipefail

if [ $# -eq 0 ]; then
  echo "usage: video FILE..." >&2
  exit 1
fi

args=()
for f in "$@"; do
  f=${f//\\/\\\\}
  args+=(-F "video=@\"${f//\"/\\\"}\"")
done

body=$(curl -sS --fail-with-body "${args[@]}" https://videos.natwelch.com/api/upload) || {
  jq -r '.message // empty' <<<"$body" >&2
  exit 1
}
year=$(date -u +%Y)
urls=$(jq -r --arg year "$year" '.jobs[] | "https://videos.natwelch.com/videos/\($year)/\(.id | sub("\\.[^.]+$"; "")).webm"' <<<"$body")

printf '%s\n' "$urls"
if command -v pbcopy >/dev/null; then
  printf '%s' "$urls" | pbcopy
fi
